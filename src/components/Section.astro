---
/** The one wrapper every page section uses: tone, padding, container width, optional glow. */
import type { Tone } from '@/data/types';
interface Props {
  tone?: Tone;
  width?: 'copy' | 'wide' | 'full';
  glow?: 'top' | 'bottom' | false;
  padding?: 'section' | 'tight' | 'none';
  id?: string;
  class?: string;
  as?: 'section' | 'div' | 'article' | 'aside';
  labelledby?: string;
  /** Legacy props kept for the starter: no-ops in this world. */
  grain?: boolean;
  courseLines?: boolean;
}
const { tone = 'ground', width = 'copy', glow = false, padding = 'section', id, class: className, as: Tag = 'section', labelledby } = Astro.props;
---

<Tag id={id} data-tone={tone} aria-labelledby={labelledby} class:list={['section', `pad-${padding}`, { glow: glow === 'top', 'glow-bottom': glow === 'bottom' }, className]}>
  {width === 'full' ? <slot /> : <div class:list={['wrap', { 'wrap--wide': width === 'wide' }]}><slot /></div>}
</Tag>
