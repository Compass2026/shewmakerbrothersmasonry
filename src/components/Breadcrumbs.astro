---
interface Props {
  items: { name: string; href: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="breadcrumbs">
  <ol>
    {items.map((item, i) => (
      <li>
        {i < items.length - 1 ? <a href={item.href}>{item.name}</a> : <span aria-current="page">{item.name}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs ol { display: flex; flex-wrap: wrap; gap: 4px 10px; list-style: none; margin: 0; padding: 0; font-size: 0.875rem; color: var(--muted); }
  .breadcrumbs li + li::before { content: "/"; margin-right: 10px; color: var(--color-fieldstone); }
  .breadcrumbs a { color: var(--muted); text-decoration: none; }
  .breadcrumbs a:hover { color: var(--heading); text-decoration: underline; }
  .breadcrumbs [aria-current] { color: var(--heading); }
</style>
