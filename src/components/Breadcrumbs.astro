---
interface Props { items: { name: string; href: string }[] }
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="breadcrumbs">
  <ol>
    {items.map((item, i) => (
      <li>{i < items.length - 1 ? <a href={item.href}>{item.name}</a> : <span aria-current="page">{item.name}</span>}</li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs ol { display: flex; flex-wrap: wrap; gap: 4px 12px; list-style: none; margin: 0; padding: 0; font-family: var(--font-condensed); font-weight: 600; font-size: 0.8125rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }
  .breadcrumbs li + li::before { content: "/"; margin-right: 12px; color: var(--accent); }
  .breadcrumbs a { color: var(--muted); text-decoration: none; }
  .breadcrumbs a:hover { color: var(--accent); }
  .breadcrumbs [aria-current] { color: var(--heading); }
</style>
