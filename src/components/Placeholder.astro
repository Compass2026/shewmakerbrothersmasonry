---
/** Pending-photo note: a quiet dashed block naming the shot still to come. Logged into docs/placeholders.md from data-* attributes. */
interface Props { ratio?: string; need: string; slotName: string; thumb?: string; label?: string; class?: string }
const { ratio, need, slotName, label = 'Photo to come', class: className } = Astro.props;
---

<div class:list={['pending', className]} style={ratio ? `--ratio: ${ratio}` : undefined} data-placeholder data-page={Astro.url.pathname} data-slot={slotName} data-need={need}>
  <p class="pending__label">{label}</p>
  <p class="pending__need">{need}</p>
</div>
