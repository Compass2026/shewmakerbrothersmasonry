---
interface Props { need: string; slotName: string; label?: string; class?: string }
const { need, slotName, label = 'To confirm', class: className } = Astro.props;
---

<div class:list={['pending', 'pending--text', className]} style="--ratio: auto" data-placeholder data-page={Astro.url.pathname} data-slot={slotName} data-need={need}>
  <p class="pending__label">{label}</p>
  <p class="pending__need">{need}</p>
</div>

<style>
  .pending--text { aspect-ratio: auto; justify-items: start; text-align: left; padding: 14px 18px; }
  .pending--text .pending__need { max-width: 64ch; }
</style>
