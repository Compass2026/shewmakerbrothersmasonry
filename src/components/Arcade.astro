---
/** A run of stone piers under one poured cap, carrying a section edge. */
interface Props { count?: number; height?: string; class?: string }
const { count = 9, height, class: className } = Astro.props;
---

<div class:list={['arcade', className]} style={height ? `--arcade-h: ${height}` : undefined} aria-hidden="true">
  <div class="arcade__cap"></div>
  <div class="arcade__piers">
    {Array.from({ length: count }).map((_, i) => <span class="arcade__pier" style={`--px: ${12 + ((i * 29) % 76)}%; --py: ${20 + ((i * 37) % 60)}%`}></span>)}
  </div>
</div>
