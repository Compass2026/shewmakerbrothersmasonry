---
import { site, telHref } from '@/config/site';
import { segments, servicesBySegment, servicePath } from '@/data/taxonomy';
import PhoneLink from './PhoneLink.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const servicesActive = segments.some((seg) => servicesBySegment(seg.id).some((s) => path.startsWith(servicePath(s.slug))));
---

<header class="site-header" data-header>
  <div class="wrap wrap--wide site-header__row">
    <a class="brand" href="/" aria-label={`${site.name}, home`}>
      <img class="brand__badge" src={site.logo.small} width="300" height="450" alt="" decoding="async" fetchpriority="high" />
      <span class="brand__name" aria-hidden="true"><span class="brand__line1">Shewmaker Brothers</span><span class="brand__line2">Masonry · Lake of the Ozarks</span></span>
    </a>
    <nav class="nav" aria-label="Primary">
      <ul class="nav__list">
        <li class="nav__item nav__item--menu">
          <button type="button" class:list={['nav__link', { 'is-active': servicesActive }]} aria-expanded="false" aria-controls="services-menu" data-menu-toggle>Services<Icon name="chevron" size={14} class="nav__chevron" /></button>
          <div id="services-menu" class="menu" data-menu hidden>
            <div class="menu__grid">
              {segments.map((seg) => (
                <div class="menu__group">
                  <p class="menu__heading">{seg.name}</p>
                  <ul class="menu__list">
                    {servicesBySegment(seg.id).map((s) => (
                      <li><a href={servicePath(s.slug)} class:list={['menu__link', { 'is-active': path.startsWith(servicePath(s.slug)) }]}>{s.navLabel ?? s.name}</a></li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </li>
        {site.nav.map((item) => (
          <li class="nav__item"><a href={item.href} class:list={['nav__link', { 'is-active': isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="site-header__actions">
      <PhoneLink class="site-header__phone" />
      <Button href={site.cta.secondaryHref} class="site-header__cta">{site.cta.secondary}</Button>
      <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="nav-panel" data-nav-toggle>
        <span class="sr-only">Menu</span>
        <svg class="nav-toggle__icon nav-toggle__icon--open" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M2 5h18M2 11h18M2 17h18" fill="none" stroke="currentColor" stroke-width="2" /></svg>
        <svg class="nav-toggle__icon nav-toggle__icon--close" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M4 4l14 14M18 4L4 18" fill="none" stroke="currentColor" stroke-width="2" /></svg>
      </button>
    </div>
  </div>
  <div id="nav-panel" class="nav-panel" data-nav-panel hidden>
    <div class="wrap wrap--wide nav-panel__inner">
      <nav aria-label="Mobile">
        <ul class="nav-panel__list">
          <li>
            <details class="nav-panel__details">
              <summary class="nav-panel__link nav-panel__summary">Services<Icon name="chevron" size={20} class="nav-panel__chevron" /></summary>
              <div class="nav-panel__sub">
                {segments.map((seg) => (
                  <div class="nav-panel__group">
                    <p class="eyebrow">{seg.name}</p>
                    <ul>{servicesBySegment(seg.id).map((s) => <li><a href={servicePath(s.slug)}>{s.navLabel ?? s.name}</a></li>)}</ul>
                  </div>
                ))}
              </div>
            </details>
          </li>
          {site.nav.map((item) => (
            <li><a class="nav-panel__link" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
      <div class="nav-panel__foot">
        <p class="t-small muted">Service-area business based in {site.base.locality}, {site.base.regionName}.</p>
        <Button href={telHref} icon="phone" class="nav-panel__cta">{site.cta.primary}</Button>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const navToggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const navPanel = document.querySelector<HTMLElement>('[data-nav-panel]');
  const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const menuItem = menuToggle?.closest<HTMLElement>('.nav__item--menu');
  if (header) {
    let compact = false;
    const onScroll = () => { const next = window.scrollY > 24; if (next !== compact) { compact = next; header.classList.toggle('is-compact', next); } };
    window.addEventListener('scroll', onScroll, { passive: true }); onScroll();
  }
  const setNav = (open: boolean) => { if (!navToggle || !navPanel) return; navToggle.setAttribute('aria-expanded', String(open)); navPanel.hidden = !open; document.documentElement.classList.toggle('nav-open', open); };
  navToggle?.addEventListener('click', () => setNav(navToggle.getAttribute('aria-expanded') !== 'true'));
  const setMenu = (open: boolean) => { if (!menuToggle || !menu) return; menuToggle.setAttribute('aria-expanded', String(open)); menu.hidden = !open; };
  const hoverCapable = window.matchMedia('(hover: hover)').matches;
  menuToggle?.addEventListener('click', (e) => { const open = menuToggle.getAttribute('aria-expanded') === 'true'; if (!open) setMenu(true); else if (e.detail === 0 || !hoverCapable) setMenu(false); });
  if (menuItem && hoverCapable) { let timer: number | undefined; menuItem.addEventListener('pointerenter', () => { window.clearTimeout(timer); setMenu(true); }); menuItem.addEventListener('pointerleave', () => { timer = window.setTimeout(() => setMenu(false), 160); }); }
  menuItem?.addEventListener('focusout', (e) => { if (!menuItem.contains(e.relatedTarget as Node | null)) setMenu(false); });
  document.addEventListener('click', (e) => { if (menu && !menu.hidden && menuItem && !menuItem.contains(e.target as Node)) setMenu(false); });
  document.addEventListener('keydown', (e) => { if (e.key !== 'Escape') return; if (menu && !menu.hidden) { setMenu(false); menuToggle?.focus(); } if (navPanel && !navPanel.hidden) { setNav(false); navToggle?.focus(); } });
  window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => { if (e.matches) setNav(false); });
</script>

<style>
  .site-header { position: fixed; top: 0; left: 0; right: 0; z-index: 50; background: rgba(25, 20, 16, 0.88); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid var(--joint); }
  .site-header.is-compact { background: rgba(25, 20, 16, 0.95); }
  /* impeccable-disable-next-line layout-transition: fixed header, the document offset is constant so nothing reflows */
  .site-header__row { position: relative; z-index: 2; display: flex; align-items: center; gap: 22px; min-height: 188px; transition: min-height 300ms var(--ease-expo); }
  .site-header.is-compact .site-header__row { min-height: 72px; }
  .brand { display: flex; align-items: center; gap: 12px; margin-right: auto; min-width: 0; overflow: hidden; text-decoration: none; color: var(--color-chalk); }
  /* impeccable-disable-next-line layout-transition: the badge shrinks with the fixed header; no document reflow */
  .brand__badge { width: auto; height: 168px; transition: height 300ms var(--ease-expo); }
  .site-header.is-compact .brand__badge { height: 54px; }
  /* The badge spells the name at full size, so the set wordmark only appears once the bar
     compacts and the badge is too small to read. */
  .brand__name { display: none; flex-direction: column; line-height: 1; }
  .site-header.is-compact .brand__name { display: flex; }
  .brand__line1 { font-family: var(--font-display); font-size: 1.5rem; letter-spacing: 0.02em; text-transform: uppercase; color: var(--color-chalk); white-space: nowrap; transition: font-size 260ms var(--ease-expo); }
  .site-header.is-compact .brand__line1 { font-size: 1.375rem; }
  .brand__line2 { margin-top: 4px; font-family: var(--font-condensed); font-weight: 600; font-size: 0.6875rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--color-amber); }
  .nav { display: none; }
  .nav__list { display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .nav__item { position: relative; }
  .nav__link { position: relative; display: inline-flex; align-items: center; gap: 6px; padding: 10px 10px; white-space: nowrap; font-family: var(--font-condensed); font-weight: 600; font-size: 0.9375rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-mortar-dim); text-decoration: none; background: none; border: 0; cursor: pointer; }
  .nav__link:hover { color: var(--color-chalk); }
  .nav__link.is-active { color: var(--color-chalk); }
  .nav__link::after { content: ""; position: absolute; left: 10px; right: 10px; bottom: 4px; height: 2px; background: var(--color-amber); transform: scaleX(0); transform-origin: left center; transition: transform 240ms var(--ease-expo); }
  .nav__link:hover::after, .nav__link[aria-expanded="true"]::after, .nav__link.is-active::after { transform: scaleX(1); }
  :global(.nav__chevron) { transition: transform 160ms ease; }
  .nav__link[aria-expanded="true"] :global(.nav__chevron) { transform: rotate(180deg); }
  .menu { position: absolute; top: calc(100% + 10px); left: 0; width: min(54rem, calc(100vw - 2 * var(--spacing-gutter))); padding: 28px; background: var(--color-ground-2); border: 1px solid var(--joint-strong); box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.8); }
  .menu__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px 32px; }
  .menu__heading { margin: 0 0 12px; font-family: var(--font-condensed); font-weight: 600; font-size: 0.8125rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--color-amber); }
  .menu__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .menu__link { color: var(--color-mortar); text-decoration: none; font-size: 1rem; }
  .menu__link:hover, .menu__link.is-active { color: var(--color-amber); }
  .site-header__actions { display: flex; align-items: center; gap: 16px; flex: none; }
  .site-header__phone { font-size: 1.125rem; }
  :global(.site-header__cta) { display: none; min-height: 46px; padding-block: 12px; white-space: nowrap; }
  .nav-toggle { display: inline-grid; place-items: center; width: 46px; height: 46px; background: none; border: 1px solid var(--joint-strong); color: var(--color-chalk); cursor: pointer; }
  .nav-toggle__icon--close { display: none; }
  .nav-toggle[aria-expanded="true"] .nav-toggle__icon--open { display: none; }
  .nav-toggle[aria-expanded="true"] .nav-toggle__icon--close { display: block; }
  .nav-panel { position: fixed; inset: 0; z-index: 1; padding-top: var(--header-h); background: var(--color-ground); overflow-y: auto; }
  .nav-panel__inner { display: flex; flex-direction: column; min-height: calc(100dvh - var(--header-h)); padding-top: 16px; padding-bottom: 32px; }
  .nav-panel__list { list-style: none; margin: 0; padding: 0; }
  .nav-panel__link { display: block; padding: 16px 0; font-family: var(--font-display); font-size: 2rem; letter-spacing: 0.02em; text-transform: uppercase; line-height: 1; color: var(--color-chalk); text-decoration: none; border-bottom: 1px solid var(--joint); }
  .nav-panel__link[aria-current] { color: var(--color-amber); }
  summary.nav-panel__link { cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between; }
  summary.nav-panel__link::-webkit-details-marker { display: none; }
  :global(.nav-panel__chevron) { color: var(--color-amber); transition: transform 160ms ease; }
  .nav-panel__details[open] :global(.nav-panel__chevron) { transform: rotate(180deg); }
  .nav-panel__sub { display: grid; gap: 20px; padding: 14px 0 20px; border-bottom: 1px solid var(--joint); }
  .nav-panel__group ul { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 10px; }
  .nav-panel__group a { color: var(--color-mortar); text-decoration: none; font-size: 1.0625rem; }
  .nav-panel__foot { margin-top: auto; padding-top: 32px; display: grid; gap: 16px; justify-items: start; }
  :global(html.nav-open) { overflow: hidden; }
  @media (min-width: 30rem) { .site-header__row { min-height: 264px; } .brand__badge { height: 240px; } .site-header.is-compact .site-header__row { min-height: 80px; } .site-header.is-compact .brand__badge { height: 60px; } }
  @media (min-width: 64rem) { .nav { display: block; } :global(.site-header__cta) { display: inline-flex; } .nav-toggle { display: none; } }
</style>
