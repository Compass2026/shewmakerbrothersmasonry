---
import type { Segment } from '@/data/types';
import { servicesBySegment, servicePath } from '@/data/taxonomy';
import Eyebrow from './Eyebrow.astro';

interface Props {
  segment: Segment;
}
const { segment } = Astro.props;
const list = servicesBySegment(segment.id);
---

<div class="card segment-card">
  <div class="card__body">
    <Eyebrow>{segment.blurb}</Eyebrow>
    <h3 class="t-subtitle">{segment.name}</h3>
    <ul class="segment-card__list">
      {list.map((s) => (
        <li><a class="link" href={servicePath(s.slug)}>{s.name}</a></li>
      ))}
    </ul>
  </div>
</div>

<style>
  .segment-card .card__body { display: grid; gap: 12px; }
  .segment-card__list { list-style: none; margin: 4px 0 0; padding: 0; display: grid; gap: 8px; }
</style>
