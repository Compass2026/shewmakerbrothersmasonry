---
import type { Faq } from '@/data/types';
import Icon from './Icon.astro';
interface Props { faqs: Faq[]; heading?: string; id?: string }
const { faqs, heading = 'Questions we get asked', id = 'faq' } = Astro.props;
---

<div class="faq" id={id}>
  <div class="sec-head">
    <p class="eyebrow has-rule">Straight answers</p>
    <h2 class="t-title">{heading}</h2>
  </div>
  <div class="faq__list">
    {faqs.map((f) => (
      <details class="block faq__item">
        <summary class="faq__q"><h3 class="faq__h">{f.q}</h3><span class="faq__mark"><Icon name="plus" size={18} /></span></summary>
        <div class="faq__a prose"><p>{f.a}</p></div>
      </details>
    ))}
  </div>
</div>

<style>
  .faq { display: grid; gap: 32px; }
  .faq__list { display: grid; gap: 12px; }
  .faq__q { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 24px; cursor: pointer; list-style: none; }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__h { font-family: var(--font-condensed); font-weight: 700; font-size: 1.25rem; letter-spacing: 0.03em; text-transform: uppercase; }
  .faq__mark { flex: none; display: grid; place-items: center; width: 34px; height: 34px; border: 1px solid var(--joint-strong); color: var(--color-ember); transition: transform 160ms ease; }
  .faq__item[open] .faq__mark { transform: rotate(45deg); }
  .faq__a { padding: 0 24px 22px; }
</style>
