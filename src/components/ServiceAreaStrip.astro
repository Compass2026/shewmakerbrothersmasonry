---
import Section from './Section.astro';
import Eyebrow from './Eyebrow.astro';
import { site } from '@/config/site';
import { cities, cityPath, foldIns } from '@/data/cities';
import { copy } from '@/data/copy/global';

interface Props {
  heading?: string;
}
const { heading = copy.serviceArea.heading } = Astro.props;
const countyLine = `${site.counties.slice(0, -1).join(', ')} and ${site.counties[site.counties.length - 1]} counties`;
---

<Section tone="ground" grain labelledby="area-heading" class="area">
  <div class="area__grid">
    <div class="heading-group">
      <Eyebrow rule>Service area</Eyebrow>
      <h2 id="area-heading" class="t-title">{heading}</h2>
      <p class="t-lead">{copy.serviceArea.line}</p>
    </div>
    <div class="area__body">
      <ul class="area__towns">
        {cities.map((c) => (
          <li><a class="link" href={cityPath(c.slug)}>{c.name}</a></li>
        ))}
        {foldIns.map((f) => (
          <li><a class="link" href={f.anchor}>{f.name}</a></li>
        ))}
      </ul>
      <p class="area__counties">{countyLine}. <a class="link" href="/service-area/">See the whole service area</a>.</p>
      <p class="muted">{copy.ameren}</p>
    </div>
  </div>
</Section>

<style>
  .area__grid { display: grid; gap: 32px; }
  .area__body { display: grid; gap: 20px; align-content: start; }
  .area__towns { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 24px; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.75rem); text-transform: uppercase; letter-spacing: 0.02em; }
  .area__towns .link { color: var(--heading); text-decoration-thickness: 2px; }
  @media (min-width: 64rem) {
    .area__grid { grid-template-columns: 5fr 7fr; gap: 48px; }
  }
</style>
