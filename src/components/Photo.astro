---
import { imageByFile, imageSrc } from '@/data/images';
interface Props { file: string; caption?: string | false; class?: string; eager?: boolean }
const { file, caption, class: className, eager = false } = Astro.props;
const img = imageByFile(file);
if (!img) throw new Error(`Unknown project image: ${file}`);
const cap = caption === false ? undefined : (caption ?? img.caption ?? img.alt);
---

<figure class:list={['photo', className]}>
  <img src={imageSrc(img.file)} width={img.width} height={img.height} alt={img.alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  {cap && <figcaption class="photo__caption">{cap}</figcaption>}
</figure>
