---
import { site, telHref } from '@/config/site';
import { segments, servicesBySegment, servicePath } from '@/data/taxonomy';
import { cities, cityPath, foldIns } from '@/data/cities';
import Button from './Button.astro';
const year = new Date().getFullYear();
const countyLine = `${site.counties.slice(0, -1).join(', ')} and ${site.counties[site.counties.length - 1]} counties`;
---

<div class="course-stripe" aria-hidden="true"></div>
<footer class="site-footer" data-tone="shadow">
  <div class="wrap wrap--wide">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a href="/" class="site-footer__lockup" aria-label={`${site.name}, home`}>
          <img src={site.logo.badge} width="64" height="64" alt="" loading="lazy" decoding="async" />
          <span><span class="site-footer__name">Shewmaker Brothers</span><span class="site-footer__sub">Masonry</span></span>
        </a>
        <p class="site-footer__tag">Third generation. Own crews.<br />Stone on a footing.</p>
        <p class="t-small muted">{site.base.locality}, {site.base.regionName}. Serving the {site.market}: {countyLine}.</p>
      </div>
      <nav class="site-footer__col site-footer__services" aria-label="Services">
        <p class="site-footer__heading">Services</p>
        <ul>
          {segments.flatMap((seg) => servicesBySegment(seg.id)).map((s) => (
            <li><a href={servicePath(s.slug)}>{s.navLabel ?? s.name}</a></li>
          ))}
        </ul>
      </nav>
      <nav class="site-footer__col" aria-label="Service area">
        <p class="site-footer__heading">Service area</p>
        <ul>
          {cities.map((c) => <li><a href={cityPath(c.slug)}>{c.name}</a></li>)}
          {foldIns.map((f) => <li><a href={f.anchor}>{f.name}</a></li>)}
          <li><a href="/service-area/">All of the service area</a></li>
        </ul>
      </nav>
      <div class="site-footer__col site-footer__touch">
        <p class="site-footer__heading">Get in touch</p>
        <ul>
          <li><a class="phone" href={telHref}>{site.phone.display}</a></li>
          <li>Ask for Sam. Call or text.</li>
          <li>{site.base.locality}, {site.base.regionName}</li>
          <li><a href={site.social.facebook} rel="noopener" target="_blank">Facebook</a></li>
          <li><a href="/projects/">Projects</a> · <a href="/about/">About</a> · <a href="/blog/">Blog</a></li>
        </ul>
        <Button href={site.cta.secondaryHref} class="site-footer__cta">{site.cta.secondary}</Button>
      </div>
    </div>
    <div class="site-footer__bottom">
      <p class="t-small muted">{`© ${year} ${site.name}. Based in ${site.base.locality}, ${site.base.regionName}. Service-area business, no street address.`}</p>
      <p class="site-footer__motto">Built on a footing.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--color-pit); color: var(--ink); padding: 64px 0 28px; }
  .site-footer__grid { display: grid; gap: 40px; }
  .site-footer__brand { display: grid; gap: 14px; align-content: start; }
  .site-footer__lockup { display: flex; align-items: center; gap: 14px; text-decoration: none; }
  .site-footer__lockup > span { display: flex; flex-direction: column; line-height: 1; }
  .site-footer__name { font-family: var(--font-display); font-size: 1.5rem; text-transform: uppercase; letter-spacing: 0.02em; color: var(--color-chalk); }
  .site-footer__sub { margin-top: 5px; font-family: var(--font-condensed); font-weight: 600; font-size: 0.75rem; letter-spacing: 0.26em; text-transform: uppercase; color: var(--color-ember); }
  .site-footer__tag { font-family: var(--font-condensed); font-weight: 600; font-size: 1rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-mortar-dim); line-height: 1.6; }
  .site-footer__heading { font-family: var(--font-condensed); font-weight: 600; font-size: 0.8125rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--color-ember); margin-bottom: 14px; }
  .site-footer__col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .site-footer__col a { color: var(--color-mortar); text-decoration: none; }
  .site-footer__col a:hover { color: var(--color-ember); }
  .site-footer__services ul { grid-template-columns: 1fr 1fr; column-gap: 20px; }
  .site-footer__touch { display: grid; gap: 20px; align-content: start; }
  :global(.site-footer__cta) { justify-self: start; }
  .site-footer__bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; margin-top: 48px; padding-top: 22px; border-top: 1px solid var(--joint); }
  .site-footer__motto { font-family: var(--font-condensed); font-weight: 600; font-size: 0.8125rem; letter-spacing: 0.26em; text-transform: uppercase; color: var(--color-ember); }
  @media (min-width: 40rem) { .site-footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 64rem) { .site-footer__grid { grid-template-columns: 1.2fr 1.4fr 0.8fr 1fr; gap: 48px; } }
</style>
