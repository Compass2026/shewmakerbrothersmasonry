---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import Hero from '@/components/Hero.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import BeforeAfter from '@/components/BeforeAfter.astro';
import Placeholder from '@/components/Placeholder.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CtaBlock from '@/components/CtaBlock.astro';
import { segments } from '@/data/taxonomy';
import { images, pairs } from '@/data/images';
import { breadcrumbNode, webPageNode } from '@/lib/schema';

const path = '/projects/';
const metaTitle = 'Masonry Projects at the Lake of the Ozarks';
const description = 'Stone seawalls, lakefront walls, stairs, flagstone patios, fireplaces and chimneys by our own crews around the Lake of the Ozarks. Call Sam at 573-569-3690.';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Projects', href: path }];
const states = [{ id: 'before', label: 'Before' }, { id: 'during', label: 'During' }, { id: 'after', label: 'After' }, { id: 'detail', label: 'Detail' }];
const ordered = [...images].sort((a, b) => (a.hero === b.hero ? 0 : a.hero ? -1 : 1));
const schema = [webPageNode({ path, name: metaTitle, description, type: 'CollectionPage' }), breadcrumbNode(crumbs)];
---

<Base title={metaTitle} description={description} schema={schema}>
  <Hero display eyebrow="Projects · Lake of the Ozarks" title="The work." accent="work." lead="Mortared stone seawalls, lakefront walls, stairs, patios, fireplaces and chimneys around the Lake of the Ozarks. Every photograph here is our work. These are interim frames; the full-size originals are still to come." photo="stone-seawall-lakefront-01.jpg" ctas={false} compact>
    <Breadcrumbs items={crumbs} slot="above" />
  </Hero>

  <Section tone="lifted" padding="tight" width="wide" labelledby="filter-heading" class="filters">
    <h2 id="filter-heading" class="sr-only">Filter the gallery</h2>
    <div class="filters__row" data-filter-group="segment">
      <span class="eyebrow filters__label">Work</span>
      <button type="button" class="chip" data-filter="segment" data-value="all" aria-pressed="true">All</button>
      {segments.map((s) => <button type="button" class="chip" data-filter="segment" data-value={s.id} aria-pressed="false">{s.name}</button>)}
    </div>
    <div class="filters__row" data-filter-group="state">
      <span class="eyebrow filters__label">Stage</span>
      <button type="button" class="chip" data-filter="state" data-value="all" aria-pressed="true">All</button>
      {states.map((s) => <button type="button" class="chip" data-filter="state" data-value={s.id} aria-pressed="false">{s.label}</button>)}
    </div>
    <p class="t-small muted filters__count" data-count aria-live="polite">{images.length} photographs</p>
  </Section>

  <Section tone="ground" width="wide" labelledby="gallery-heading">
    <h2 id="gallery-heading" class="sr-only">Photographs</h2>
    <div class="gallery" data-gallery>
      {ordered.map((img, i) => <ProjectCard file={img.file} eager={i < 3} />)}
    </div>
    <p class="gallery__empty muted" data-empty hidden>Nothing in this set yet. That is a photo we still need from Sam.</p>
  </Section>

  <Section tone="lifted" glow="top" labelledby="pairs-heading">
    <div class="pairs">
      <div class="sec-head">
        <Eyebrow rule>Before and after</Eyebrow>
        <h2 id="pairs-heading" class="t-title">The same shoreline, <span class="accent">before and after.</span></h2>
      </div>
      {pairs.map((p) => <BeforeAfter before={p.before.file} after={p.after.file} />)}
    </div>
  </Section>

  <Section tone="ground" labelledby="missing-heading">
    <div class="missing">
      <div class="sec-head">
        <Eyebrow rule>Still to photograph</Eyebrow>
        <h2 id="missing-heading" class="t-title">What is <span class="accent">not here yet.</span></h2>
        <p class="t-lead">Work we do that has no photograph in the interim set. Each becomes a gallery block the day an original arrives.</p>
      </div>
      <Placeholder ratio="auto" slotName="gallery-missing" need="Chimney repair before and after; a new chimney; tuckpointing before and after; block masonry; concrete flatwork; excavation with equipment on site; exterior stone veneer; an outdoor kitchen with counters; a commercial exterior; lakefront stairs down to a dock; a finished seawall in summer; stone and joint close-ups." />
    </div>
  </Section>

  <CtaBlock line1="Want yours in here?" line2="Talk to Sam." />
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-gallery] [data-segments]');
  const count = document.querySelector<HTMLElement>('[data-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const active: Record<string, string> = { segment: 'all', state: 'all' };
  const apply = () => {
    let shown = 0;
    cards.forEach((card) => {
      const segs = (card.dataset.segments ?? '').split(' ');
      const show = (active.segment === 'all' || segs.includes(active.segment)) && (active.state === 'all' || card.dataset.state === active.state);
      card.hidden = !show; if (show) shown += 1;
    });
    if (count) count.textContent = `${shown} photograph${shown === 1 ? '' : 's'}`;
    if (empty) empty.hidden = shown > 0;
  };
  buttons.forEach((btn) => btn.addEventListener('click', () => { const group = btn.dataset.filter!; active[group] = btn.dataset.value!; buttons.forEach((b) => { if (b.dataset.filter === group) b.setAttribute('aria-pressed', String(b === btn)); }); apply(); }));
</script>

<style>
  :global(.filters) { border-bottom: 1px solid var(--joint); }
  @media (min-width: 64rem) { :global(.filters) { position: sticky; top: 80px; z-index: 30; } }
  .filters__row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .filters__row + .filters__row { margin-top: 10px; }
  .filters__label { min-width: 56px; }
  .filters__count { margin-top: 12px; }
  .chip { font-family: var(--font-condensed); font-weight: 600; font-size: 0.9375rem; letter-spacing: 0.1em; text-transform: uppercase; line-height: 1; padding: 11px 16px; min-height: 40px; background: var(--card); color: var(--heading); border: 1px solid var(--joint); cursor: pointer; transition: border-color 120ms ease, background-color 120ms ease, color 120ms ease; }
  .chip:hover { border-color: var(--joint-strong); }
  .chip[aria-pressed="true"] { background: var(--color-ember); color: var(--color-coal); border-color: var(--color-ember); }
  .gallery { display: grid; gap: 16px; align-items: start; }
  .gallery__empty { margin-top: 24px; }
  @media (min-width: 40rem) {
    .gallery { grid-template-columns: repeat(4, 1fr); }
    :global(.gallery > .project-card) { grid-column: span 2; }
    :global(.gallery > .project-card:nth-child(3n + 3 of :not([hidden]))) { grid-column: 2 / span 2; }
  }
  @media (min-width: 64rem) {
    .gallery { grid-template-columns: repeat(8, 1fr); gap: 22px; }
    :global(.gallery > .project-card:nth-child(3n + 3 of :not([hidden]))) { grid-column: span 2; }
    :global(.gallery > .project-card:nth-child(7n + 5 of :not([hidden]))) { grid-column: 2 / span 2; }
  }
  .pairs, .missing { display: grid; gap: 32px; }
</style>
